{
	"name": "@a11y-ui/core",
	"version": "1.1.7-rc.2",
	"license": "EUPL-1.2",
	"description": "This library implements functions to use the adopted style of web components for multiple themes.",
	"author": {
		"email": "github@martinoppitz.com",
		"name": "Martin Oppitz",
		"url": "https://martinoppitz.com"
	},
	"contributors": [
		{
			"email": "github@martinoppitz.com",
			"name": "Martin Oppitz",
			"url": "https://martinoppitz.com"
		}
	],
	"scripts": {
		"build": "pnpm build:unbuild",
		"build:tsup": "tsup src/index.ts --clean --minify --dts --format cjs,esm --out-dir dist",
		"build:unbuild": "unbuild",
		"format": "prettier --check src",
		"lint": "tsc --noemit && eslint src",
		"prepack": "npm run build",
		"unused": "knip"
	},
	"devDependencies": {
		"@swc/core": "1.10.1",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"adopted-style-sheets": "workspace:*",
		"eslint": "8.57.1",
		"knip": "5.40.0",
		"prettier": "3.4.2",
		"tsup": "8.3.5",
		"typescript": "5.7.2",
		"unbuild": "1.2.1"
	},
	"peerDependencies": {
		"adopted-style-sheets": "latest"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	]
}
